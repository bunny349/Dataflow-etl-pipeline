<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PipelineViz — Sales Analytics Dashboard</title>
<link rel="stylesheet" href="style.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
</head>
<body>
  <div class="bg-glow"></div>

  <header class="hero">
    <div class="badge">📊 Data Pipeline Dashboard</div>
    <h1>Pipeline<span class="accent">Viz</span></h1>
    <p class="subtitle">Raw e-commerce order data → cleaned, transformed, and visualized. Powered by Pandas + Prefect + FastAPI.</p>
    <button id="runBtn">↻ Re-run Pipeline</button>
  </header>

  <main class="container">
    <section class="kpi-grid" id="kpiGrid">
      <!-- populated by JS -->
    </section>

    <section class="charts-grid">
      <div class="card">
        <h3>Revenue by Category</h3>
        <canvas id="categoryChart"></canvas>
      </div>
      <div class="card">
        <h3>Revenue by Region</h3>
        <canvas id="regionChart"></canvas>
      </div>
      <div class="card wide">
        <h3>Monthly Revenue Trend</h3>
        <canvas id="trendChart"></canvas>
      </div>
      <div class="card wide">
        <h3>Top Products</h3>
        <canvas id="productsChart"></canvas>
      </div>
    </section>

    <p id="status" class="status"></p>
  </main>

  <footer>
    <p>PipelineViz · Pandas + Prefect + FastAPI · <a href="https://github.com" target="_blank" rel="noopener">View on GitHub</a></p>
  </footer>

  <script src="app.js"></script>
</body>
</html>
